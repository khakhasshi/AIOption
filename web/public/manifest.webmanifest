{
  "name": "AI Option Scanner",
  "short_name": "AI Option",
  "description": "AI-powered option analysis and trading workflow cockpit.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",

# Copy this file to .env. Never commit .env or provider credentials.

# AI provider (optional; scans can run with --no-ai)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Local Docker state
AI_OPTION_POSTGRES_PASSWORD=change-this-local-password
# AI_OPTION_DATABASE_URL=postgresql://ai_option:password@localhost:54321/ai_option
# AI_OPTION_REDIS_URL=redis://localhost:63790/0

# Authentication. Configure at least one user before exposing the service.
AI_OPTION_AUTH_SECRET=replace-with-at-least-32-random-characters
# AI_OPTION_AUTH_USER_1=admin
# AI_OPTION_AUTH_PASSWORD_HASH_1=pbkdf2_sha256:310000:salt:hash
# AI_OPTION_AUTH_CAN_ANALYZE_1=true
# AI_OPTION_AUTH_CAN_TRADE_1=false
# AI_OPTION_AUTH_IS_ADMIN_1=true

# Google / Apple OAuth (optional)
# GOOGLE_OAUTH_CLIENT_ID=example.apps.googleusercontent.com
# APPLE_OAUTH_CLIENT_ID=com.example.aioption.web
# APPLE_DOMAIN_ASSOCIATION_FILE=/run/secrets/apple-domain-association.txt

# Cloudflare Turnstile (optional)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Market data (optional; only configure providers you use)
# THETADATA_EMAIL=
# THETADATA_PASSWORD=
# THETADATA_CREDENTIALS_FILE=/run/secrets/thetadata-credentials
# AI_OPTION_LONGBRIDGE_BACKEND=sdk
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=

# Additional OpenAI-compatible providers (optional)
# OPENAI_API_KEY=
# QWEN_API_KEY=
# MOONSHOT_API_KEY=

# Network and process roles
# AI_OPTION_CORS_ORIGINS=https://your-domain.example
# AI_OPTION_PROCESS_ROLE=all
# AI_OPTION_DB_POOL_SIZE=4
# AI_OPTION_REDIS_MAX_CONNECTIONS=16
# AI_OPTION_SCAN_WORKERS=2
# AI_OPTION_WORKER_SCAN_THREADS=2

# Safety boundary: all broker and automated-trading switches default to false.
# Enable only after configuring authentication, paper credentials and risk limits.
AI_OPTION_ENABLE_BROKER_API=false
AI_OPTION_ENABLE_TRADING_SCHEDULER=false
AI_OPTION_ENABLE_AUTO_TRADE_SCHEDULER=false
AI_OPTION_ENABLE_ORDER_MONITOR=false

# Non-ordering background jobs
AI_OPTION_ENABLE_OBSERVATION_SCHEDULER=true
AI_OPTION_ENABLE_NOTIFICATION_WORKER=true
AI_OPTION_ENABLE_POST_MORTEM_WORKER=true

# Provider concurrency and cache tuning (optional)
# AI_OPTION_AI_CONCURRENCY=4
# AI_OPTION_YF_CONCURRENCY=3
# AI_OPTION_LONGBRIDGE_SDK_CONCURRENCY=2
# AI_OPTION_THETADATA_MARKET_DATA_TTL_SECONDS=15
# AI_OPTION_THETADATA_OPTION_CHAIN_TTL_SECONDS=15
# AI_OPTION_YF_MARKET_DATA_TTL_SECONDS=15
# AI_OPTION_LONGBRIDGE_QUOTE_TTL_SECONDS=3
